server {
    listen 80;
    listen [::]:80;
    server_name vibecursor.euroapp.site;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name vibecursor.euroapp.site;

    ssl_certificate     /etc/ssl/cloudflare/euroapp.site.pem;
    ssl_certificate_key /etc/ssl/cloudflare/euroapp.site.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /home/debian/vibecursor-web;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 256;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /robots.txt { add_header Cache-Control "public, max-age=3600"; }
    location = /sitemap.xml { add_header Cache-Control "public, max-age=3600"; }

    # browser chiede sempre /favicon.ico
    location = /favicon.ico {
        try_files /assets/favicon.ico /favicon.ico =404;
        add_header Cache-Control "public, max-age=3600";
    }

    location /assets/ {
        add_header Cache-Control "public, max-age=604800, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:jpg|jpeg|png|webp|svg|ico)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "public, max-age=300, must-revalidate";
    }
}
